      "parameters": {
        "jsCode": "// Build priority-based Slack message\nconst data = $('Parse AI Output').first().json;\nconst p = (data.priority || 'LOW').toUpperCase();\n\nconst tag = p === 'HIGH' ? '🔴 HIGH PRIORITY CLIENT'\n  : p === 'MEDIUM' ? '🟡 MEDIUM PRIORITY CLIENT'\n  : '🟢 STANDARD CLIENT';\n\nconst text = `*NEW CLIENT* — ${tag}\\n\\n*${data.client_name}* - ${data.company}\\nService: ${data.service}\\nBudget: PKR ${data.budget}\\nPriority: ${p}\\n\\nAI Summary: ${data.summary}\\nNext Action: ${data.next_action}\\n\\n✅ Airtable + Notion records created successfully.`;\n\nreturn [{ json: { text } }];"
      },
