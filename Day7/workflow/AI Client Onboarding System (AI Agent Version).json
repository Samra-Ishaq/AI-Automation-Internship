    {
      "parameters": {
        "jsCode": "// Parse AI Agent JSON output and merge with original client data\nconst clientData = $('Normalize Client Data').first().json;\nconst raw = $input.first().json.output || $input.first().json.text || '{}';\nconst cleaned = raw.replace(/```json|```/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = { service_category: 'Unclassified', priority: 'LOW', summary: 'Could not parse AI output', next_action: 'Manual review required' };\n}\n\nreturn [{\n  json: {\n    ...clientData,\n    service_category: parsed.service_category,\n    priority: (parsed.priority || 'LOW').toUpperCase(),\n    summary: parsed.summary,\n    next_action: parsed.next_action\n  }\n}];"
      },
